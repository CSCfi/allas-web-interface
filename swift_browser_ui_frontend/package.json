{
  "name": "swift_browser_ui_frontend_npm",
  "version": "2025.6.0",
  "private": true,
  "scripts": {
    "serve": "./build_wasm.sh && vite serve --mode development",
    "build": "./build_wasm.sh && vite build --mode production",
    "test": "vitest run",
    "lint": "pnpm exec eslint --fix src",
    "build-devel": "./build_wasm.sh && vite build --mode development",
    "serve-prod": "./build_wasm.sh && vite serve --mode production",
    "build-wasm": "./build_wasm.sh",
    "docker-build": "vite build --mode production && cp -f public/favicon.ico dist/favicon.ico",
    "docker-build-devel": "vite build --mode development && cp -f public/favicon.ico dist/favicon.ico"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1085.0",
    "@cscfi/csc-ui": "3",
    "@cscfi/csc-ui-vue": "^0.0.2",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@mdi/js": "^7.4.47",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vueuse/rxjs": "^14.3.0",
    "@ygoe/msgpack": "^1.0.3",
    "dexie": "^4.4.4",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "pinia": "^3.0.4",
    "vite": "^8.1.4",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "cypress": "^15.18.1",
    "cypress-cloud": "^1.13.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "pg": "^8.22.0",
    "spark-md5": "^3.0.2",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<5.0.8": ">=5.0.8",
      "fast-uri@<3.1.4": ">=3.1.4"
    }
  }
}
